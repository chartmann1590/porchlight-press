<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Location lives only on this device; exclude prefs carrying it from
        cloud backup (MASTER_PLAN privacy). Databases excluded for the same
        reason; saved stories re-sync from feeds. -->
    <exclude domain="file" path="datastore/" />
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
</full-backup-content>
