{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chartmann1590.github.io/porchlight-press/schemas/ai-brief.schema.json",
  "title": "Porchlight Press AI brief output",
  "description": "Grammar-constrained structured output of the AI newsroom (Phase 3). Non-thinking template; validator enforces grounding.",
  "type": "object",
  "additionalProperties": false,
  "required": ["headline", "dek", "body", "category", "sourceIds", "aiModel", "confidence"],
  "properties": {
    "apiVersion": {"const": 1},
    "headline": {"type": "string", "minLength": 8, "maxLength": 200},
    "dek": {"type": "string", "minLength": 10, "maxLength": 300},
    "body": {"type": "string", "minLength": 100, "maxLength": 4000},
    "category": {"enum": ["local", "public-safety", "business", "technology", "science", "sports", "entertainment", "politics", "health", "environment", "travel", "weather"]},
    "locations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["country"],
        "properties": {
          "country": {"type": "string", "pattern": "^[A-Z]{2}$"},
          "admin1": {"type": "string"},
          "admin2": {"type": "string"},
          "city": {"type": "string"},
          "metro": {"type": "string"}
        }
      }
    },
    "people": {"type": "array", "items": {"type": "string"}},
    "organizations": {"type": "array", "items": {"type": "string"}},
    "sourceIds": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "generatedAt": {"type": "string", "format": "date-time"},
    "aiModel": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
